@page "/orders"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Webshop.Client.Services.GraphQL
@using Webshop.Client.Services.REST
@using Webshop.Client.Services.SignalR
@using Webshop.Client.Services.Websockets
@using Webshop.Shared.DTOs
@inject AuthenticationStateProvider AuthProvider
@inject AppState AppState
@inject OrderRestService RestService
@inject OrderGraphQLService GraphQLService
@inject OrderSignalRService SignalRService
@inject OrderWebSocketService WebSocketService

<h3 class="mb-4">📦 Mijn bestellingen</h3>

@if (isLoading)
{
    <div class="alert alert-secondary">Bestellingen worden geladen...</div>
}
else if (!orders.Any())
{
    <div class="alert alert-info">Je hebt nog geen bestellingen geplaatst.</div>
}
else
{
    @foreach (var order in orders)
    {
        <div class="mb-4">
            <h5>Bestelling @order.OrderID - @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</h5>
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Product ID</th>
                        <th>Aantal</th>
                        <th>Prijs</th>
                        <th>Opties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.ProductID</td>
                            <td>@item.Quantity</td>
                            <td>€ @item.Price</td>
                            <td>
                                @if (item.Options.Any())
                                {
                                    <ul class="mb-0">
                                        @foreach (var option in item.Options)
                                        {
                                            <li><strong>@option.OptionType</strong>: @option.OptionValue</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">Geen opties</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="2">Totaal</td>
                        <td colspan="2">€ @order.TotalPrice</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}


