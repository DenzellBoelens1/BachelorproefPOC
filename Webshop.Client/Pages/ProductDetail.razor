@page "/product/{id:int}"
@using System.Globalization
@using Webshop.Shared.DTOs
@using Webshop.Client.Layout
@using Webshop.Client.Services.GraphQL
@using Webshop.Client.Services.REST
@using Webshop.Client.Services.SignalR
@using Webshop.Client.Services.Websockets
@implements IDisposable

<div class="container mt-5">
    <h2 class="mb-4">Productdetails</h2>

    @if (isLoading)
    {
        <div class="alert alert-info">Bezig met laden...</div>
    }
    else if (product == null)
    {
        <div class="alert alert-warning">Product niet gevonden.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title">@product.Name</h4>
                <p class="card-text"><strong>Beschrijving:</strong> @product.Description</p>
                <p class="card-text"><strong>Basisprijs:</strong> @product.BasePrice.ToString("C")</p>
                <p class="card-text"><strong>Voorraad:</strong> @product.InStock</p>

                @* CustomText-opties *@
                @if (customEnabled)
                {
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               @bind="isCustomTextEnabled" />
                        <label class="form-check-label">Voeg eigen tekst toe</label>
                    </div>
                }
                @if (customEnabled && isCustomTextEnabled)
                {
                    <div class="mb-3">
                        <label class="form-label">
                            Eigen tekst (max @maxLength tekens):
                        </label>
                        <input class="form-control"
                               @bind="customText"
                               maxlength="@maxLength" />
                        @if (pricePerChar > 0)
                        {
                            <small class="text-muted">
                                + @(customText.Length * pricePerChar).ToString("C")
                                extra
                            </small>
                        }
                    </div>
                }

                @* Andere opties per groep *@
                @foreach (var grp in product.Options
               .Where(o => o.OptionType != "CustomText")
               .GroupBy(o => o.OptionType))
                {
                    if (!selectedOptions.ContainsKey(grp.Key))
                    {
                        selectedOptions[grp.Key] = string.Empty;
                    }
                    <div class="mb-3">
                        <label class="form-label">@grp.Key</label>
                        <select class="form-select"
                                @bind="selectedOptions[grp.Key]">
                            <option value="">-- Selecteer --</option>
                            @foreach (var detail in grp)
                            {
                                <option value="@detail.OptionID">
                                    @detail.OptionValue
                                </option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label for="quantity" class="form-label">Aantal:</label>
                    <input type="number"
                           class="form-control"
                           id="quantity"
                           @bind="quantity"
                           min="1"
                           max="@product.InStock" />
                </div>

                <button class="btn btn-success"
                        @onclick="AddToCart"
                        disabled="@(!CanAddToCart)">
                    Voeg toe aan winkelmandje
                </button>
                <a href="/" class="btn btn-outline-primary ms-2">
                    ← Terug naar overzicht
                </a>
            </div>
        </div>
    }
</div>
