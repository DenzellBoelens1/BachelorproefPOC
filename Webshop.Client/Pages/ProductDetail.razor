@page "/product/{id:int}"

<div class="container mt-5">
    <h2 class="mb-4">Productdetails</h2>

    @if (isLoading)
    {
        <div class="alert alert-info">Bezig met laden…</div>
    }
    else if (product == null)
    {
        <div class="alert alert-warning">Product niet gevonden.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title">@product.Name</h4>
                <p class="card-text"><strong>Beschrijving:</strong> @product.Description</p>
                <p class="card-text"><strong>Basisprijs:</strong> @product.BasePrice.ToString("C")</p>
                <p class="card-text"><strong>Voorraad:</strong> @product.InStock</p>

                @* CustomText-opties *@
                @if (customEnabled)
                {
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               @bind="isCustomTextEnabled" />
                        <label class="form-check-label">Voeg eigen tekst toe</label>
                    </div>
                }

                @if (customEnabled && isCustomTextEnabled)
                {
                    <div class="mb-3">
                        <label class="form-label">Eigen tekst (max @maxLength tekens):</label>
                        <input class="form-control"
                               @bind="customText"
                               maxlength="@maxLength" />
                    </div>
                }

                @* Andere opties per groep *@
                @foreach (var grp in product.Options
               .Where(o => o.OptionType != "CustomText")
               .GroupBy(o => o.OptionType))
                {
                    <div class="mb-3">
                        <label class="form-label">@grp.Key</label>
                        <select class="form-select" @bind="selectedOptions[grp.Key]">
                            <option value="">-- Selecteer --</option>
                            @foreach (var opt in grp)
                            {
                                <option value="@opt.OptionID">@opt.OptionValue</option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Aantal:</label>
                    <input type="number"
                           class="form-control"
                           @bind="quantity"
                           min="1"
                           max="@product.InStock" />
                </div>

                <button class="btn btn-success"
                        @onclick="AddToCart"
                        >
                    Voeg toe aan winkelmandje
                </button>
                <a class="btn btn-outline-primary ms-2" href="/cart">
                    Naar winkelmandje
                </a>
            </div>
        </div>
    }
</div>