@page "/login"
@using Webshop.Client.Auth
@inject HttpClient Http
@inject TokenService TokenService
@inject JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<h3>Login</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="mb-3">
    <input @bind="username" class="form-control" placeholder="Gebruikersnaam" />
</div>

<div class="mb-3 input-group">
    <input @bind="password" class="form-control" placeholder="Wachtwoord" type="@passwordInputType" />
    <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility">
        @(showPassword ? "👁️" : "🙈")
    </button>
</div>

<button class="btn btn-primary" @onclick="HandleLogin" disabled="@isSubmitting">Inloggen</button>

@if (isSubmitting)
{
    <div class="text-muted mt-2">Inloggen...</div>
}


