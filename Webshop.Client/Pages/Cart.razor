@page "/cart"
@inject NavigationManager Navigation

<h3 class="mb-4">🛒 Mijn winkelmandje</h3>

@if (isLoading)
{
    <div class="alert alert-secondary">Producten worden geladen...</div>
}
else if (!cartItems.Any())
{
    <div class="alert alert-info">Je hebt nog geen producten in je winkelmandje.</div>
}
else
{
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Product</th>
                <th>Aantal</th>
                <th>Prijs</th>
                <th>Totaal</th>
                <th>Voorraad</th>
                <th>Acties</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in cartItems)
            {
                <tr>
                    <td>
                        @item.Name
                        @if (item.Options.Any())
                        {
                            <ul class="small text-muted mb-0">
                                @foreach (var opt in item.Options)
                                {
                                    <li>@opt.OptionType: @opt.OptionValue</li>
                                }
                            </ul>
                        }
                    </td>
                    <td>@item.Quantity</td>
                    <td>€ @item.UnitPrice</td>
                    <td>€ @item.TotalPrice</td>
                    <td>@item.InStock</td>
                    <td>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => RemoveFromCart(item.Key)">
                            Verwijder
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="3">Totaal</td>
                <td colspan="3">€ @cartItems.Sum(i => i.TotalPrice)</td>
            </tr>
        </tfoot>
    </table>

    <button class="btn btn-outline-primary mt-3" @onclick="GoBack">← Terug naar overzicht</button>
    <button class="btn btn-success mt-3 ms-2" @onclick="PlaceOrder">🛒 Plaats Bestelling</button>
}
