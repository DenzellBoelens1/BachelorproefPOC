@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@attribute [Authorize]

<h3>Mijn Profiel</h3>

@if (isLoading)
{
    <p>Even geduld...</p>
}
else if (!isAuthenticated)
{
    <p>Je wordt doorgestuurd naar de loginpagina...</p>
}
else
{
    <div class="card p-3">
        <p><strong>Gebruikersnaam:</strong> @userName</p>
        <p><strong>Emailadres:</strong> @email</p>
        <p><strong>Gebruikers-ID:</strong> @userId</p>
        <button class="btn btn-outline-primary mt-3" @onclick="GaNaarBestellingen">
            📦 Bekijk mijn bestellingen
        </button>
    </div>

}


